# BizHKEx environment variables.
# Copy to .env for local development. Do not commit real secrets.

# --- Server (server/_core/env.ts) ---
# OAuth app id. Also read by the Vite client as VITE_APP_ID.
VITE_APP_ID=
# Signs session cookies and provider login links.
JWT_SECRET=
# MySQL connection string used by Drizzle. Example:
# mysql://user:password@127.0.0.1:3306/bizhkex
DATABASE_URL=
# OAuth server base URL (server-side).
OAUTH_SERVER_URL=
# OpenId that is assigned the admin role on login.
OWNER_OPEN_ID=
# development | production. Production hides dev-only login logging.
NODE_ENV=development
# HTTP port. Defaults to 3000.
PORT=3000
# Forge storage / email proxy. Required for hosted photo upload and outbound email.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Inbox for quote leads, vendor intake, and business inquiries.
# Defaults to info@bizhkex.hk when unset.
INQUIRY_NOTIFY_EMAIL=info@bizhkex.hk

# --- Client (Vite) ---
# Browser OAuth portal. Falls back gracefully when unset.
VITE_OAUTH_PORTAL_URL=
# Map tiles via the Forge frontend proxy (client/src/components/Map.tsx).
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
# Optional analytics snippet in client/index.html. Leave blank to disable.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
